<div class="item-forge-shell">
  <header class="item-forge-shell__header">
    <div>
      <h2><i class="fa-solid fa-hammer"></i> {{localize "PF2E_ITEM_FORGE.App.Heading"}}</h2>
      <p>{{localize "PF2E_ITEM_FORGE.App.Subtitle"}}</p>
    </div>
    <div class="button-group">
      <button type="button" data-action="runMagicDiagnostics" class="icon-button" data-tooltip="{{localize 'PF2E_ITEM_FORGE.Actions.RunMagicDiagnostics'}}" {{#if diagnosticsBusy}}disabled{{/if}}>
        <i class="fa-solid fa-stethoscope"></i>
      </button>
      <button type="button" data-action="refreshSources" class="icon-button" data-tooltip="{{localize 'PF2E_ITEM_FORGE.Actions.RefreshSources'}}">
        <i class="fa-solid fa-rotate"></i>
      </button>
    </div>
  </header>

  <main class="item-forge-shell__editor" data-item-forge-editor-slot></main>

  {{#if magicDiagnostics}}
    <section class="item-forge-diagnostics">
      <h3><i class="fa-solid fa-stethoscope"></i> {{localize "PF2E_ITEM_FORGE.Diagnostics.Title"}}</h3>
      <p class="hint">{{localize "PF2E_ITEM_FORGE.Diagnostics.SystemVersion"}}: {{magicDiagnostics.systemVersion}} · {{localize "PF2E_ITEM_FORGE.Diagnostics.FoundryVersion"}}: {{magicDiagnostics.foundryVersion}}</p>
      <div class="chips">
        <span>{{localize "PF2E_ITEM_FORGE.Diagnostics.Passed"}}: {{magicDiagnostics.passed}}</span>
        <span>{{localize "PF2E_ITEM_FORGE.Diagnostics.Failed"}}: {{magicDiagnostics.failed}}</span>
        <span>{{localize "PF2E_ITEM_FORGE.Diagnostics.Skipped"}}: {{magicDiagnostics.skipped}}</span>
      </div>
      <ul class="item-forge-diagnostics__checks">
        {{#each magicDiagnostics.checks}}
          <li class="diagnostic-{{status}}"><strong>{{id}}</strong>: {{message}}{{#if code}} ({{code}}){{/if}}</li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  <footer class="item-forge-shell__footer">
    <div class="button-group">
      <button type="button" data-action="generate" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-hammer"></i> {{localize "PF2E_ITEM_FORGE.Actions.Generate"}}
      </button>
      <button type="button" data-action="reroll" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-dice"></i> {{localize "PF2E_ITEM_FORGE.Actions.Reroll"}}
      </button>
    </div>
    <button type="button" data-action="createItem" {{#unless hasPreview}}disabled{{/unless}}>
      <i class="fa-solid fa-floppy-disk"></i> {{localize "PF2E_ITEM_FORGE.Actions.CreateItem"}}
    </button>
  </footer>
</div>
