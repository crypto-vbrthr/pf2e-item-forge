<div class="item-forge-editor-grid">
  <section class="item-forge-panel item-forge-parameters">
    <h3>{{localize "PF2E_ITEM_FORGE.Editor.Parameters"}}</h3>

    <div class="form-group">
      <label>{{localize "PF2E_ITEM_FORGE.Fields.GenerationMode"}}</label>
      <select name="mode">
        {{#each generationModes}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      {{#if isEquipmentMode}}<p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.EquipmentMode"}}</p>{{/if}}
      {{#if isTreasureMode}}<p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.TreasureMode"}}</p>{{/if}}
      {{#if isMagicMode}}<p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.MagicMode"}}</p>{{/if}}
    </div>

    <div class="form-group">
      <label>{{localize "PF2E_ITEM_FORGE.Fields.Category"}}</label>
      <select name="category">
        {{#each categories}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    {{#if isEquipmentMode}}
    <div class="form-group">
      <label>{{localize "PF2E_ITEM_FORGE.Fields.FundamentalRunes"}}</label>
      <select name="equipment.fundamentalRunes">
        {{#each fundamentalRuneModes}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    {{#if supportsPropertyRunes}}
    <div class="form-group">
      <label>{{localize "PF2E_ITEM_FORGE.Fields.PropertyRunes"}}</label>
      <select name="equipment.propertyRunes.mode">
        {{#each propertyRuneModes}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.PropertyRuneMode"}}</p>
    </div>

    {{#if fixedPropertyRunes}}
    <fieldset class="property-rune-list">
      <legend>{{localize "PF2E_ITEM_FORGE.Fields.FixedPropertyRunes"}}</legend>
      {{#each propertyRunes}}
        <label class="checkbox property-rune-list__entry">
          <input type="checkbox" name="propertyRune" value="{{slug}}" {{#if checked}}checked{{/if}}>
          <span>{{label}}</span>
          <small>{{localize "PF2E_ITEM_FORGE.Preview.Level"}} {{level}} · {{rarityLabel}}</small>
        </label>
      {{else}}
        <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.NoPropertyRunes"}}</p>
      {{/each}}
      <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.PropertyRuneCapacity"}}</p>
    </fieldset>
    {{/if}}
    {{/if}}
    {{/if}}

    {{#if isMagicMode}}
      <fieldset class="magic-settings">
        <legend>{{localize "PF2E_ITEM_FORGE.Magic.SettingsHeading"}}</legend>
        {{#if isStaffCategory}}
          <div class="form-group">
            <label>{{localize "PF2E_ITEM_FORGE.Fields.StaffMode"}}</label>
            <select name="magic.staffMode">
              {{#each staffModes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
            <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.StaffMode"}}</p>
          </div>
        {{/if}}
        {{#if showMagicSpellSettings}}
          <div class="form-group">
            <label>{{localize "PF2E_ITEM_FORGE.Fields.MagicTheme"}}</label>
            <select name="magic.theme">
              {{#each magicThemes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
            <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.MagicTheme"}}</p>
          </div>
          <label class="checkbox">
            <input type="checkbox" name="magic.allowHeightened" {{#if request.magic.allowHeightened}}checked{{/if}}>
            {{localize "PF2E_ITEM_FORGE.Fields.AllowHeightenedSpells"}}
          </label>
          <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.AllowHeightenedSpells"}}</p>
        {{/if}}
        {{#if isSpellheartCategory}}
          <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.SpellheartMode"}}</p>
        {{/if}}
        {{#if generatedStaff}}
          <div class="form-group">
            <label>{{localize "PF2E_ITEM_FORGE.Fields.StaffProfile"}}</label>
            <select name="magic.staffProfile">
              {{#each staffProfiles}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
            <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.StaffProfile"}}</p>
          </div>
          <div class="form-group">
            <label>{{localize "PF2E_ITEM_FORGE.Fields.MagicTheme"}}</label>
            <select name="magic.theme">
              {{#each magicThemes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
            <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.MagicTheme"}}</p>
          </div>
          <label class="checkbox">
            <input type="checkbox" name="magic.allowHeightened" {{#if request.magic.allowHeightened}}checked{{/if}}>
            {{localize "PF2E_ITEM_FORGE.Fields.AllowHeightenedSpells"}}
          </label>
          <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.AllowHeightenedSpells"}}</p>
        {{/if}}
      </fieldset>
    {{/if}}

    {{#if isTreasureMode}}
      <fieldset class="treasure-settings">
        <legend>{{localize "PF2E_ITEM_FORGE.Treasure.ValueHeading"}}</legend>
        <div class="form-group">
          <label>{{localize "PF2E_ITEM_FORGE.Fields.ValueMode"}}</label>
          <select name="value.mode">
            <option value="target" {{#unless treasureValueRange}}selected{{/unless}}>{{localize "PF2E_ITEM_FORGE.Treasure.ValueTarget"}}</option>
            <option value="range" {{#if treasureValueRange}}selected{{/if}}>{{localize "PF2E_ITEM_FORGE.Treasure.ValueRange"}}</option>
          </select>
        </div>
        {{#if treasureValueRange}}
          <div class="form-row">
            <div class="form-group">
              <label>{{localize "PF2E_ITEM_FORGE.Fields.ValueMin"}}</label>
              <input type="number" name="value.min" min="0.1" step="0.1" value="{{request.value.min}}">
            </div>
            <div class="form-group">
              <label>{{localize "PF2E_ITEM_FORGE.Fields.ValueMax"}}</label>
              <input type="number" name="value.max" min="0.1" step="0.1" value="{{request.value.max}}">
            </div>
          </div>
        {{else}}
          <div class="form-row">
            <div class="form-group">
              <label>{{localize "PF2E_ITEM_FORGE.Fields.ValueTarget"}}</label>
              <input type="number" name="value.target" min="0.1" step="0.1" value="{{request.value.target}}">
            </div>
            <div class="form-group">
              <label>{{localize "PF2E_ITEM_FORGE.Fields.ValueTolerance"}}</label>
              <input type="number" name="value.tolerance" min="0" max="1" step="0.01" value="{{request.value.tolerance}}">
            </div>
          </div>
          <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.ValueTolerance"}}</p>
        {{/if}}
      </fieldset>

      <fieldset class="treasure-settings">
        <legend>{{localize "PF2E_ITEM_FORGE.Treasure.DetailsHeading"}}</legend>
        <div class="form-group">
          <label>{{localize "PF2E_ITEM_FORGE.Fields.TreasureType"}}</label>
          <select name="treasure.type">
            {{#each treasureTypes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.TreasureType"}}</p>
        </div>
        {{#if treasureSupportsMaterial}}
        <div class="form-group">
          <label>{{localize "PF2E_ITEM_FORGE.Fields.Material"}}</label>
          <select name="treasure.material">
            {{#each treasureMaterials}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        {{/if}}
        {{#if treasureSupportsCraftsmanship}}
        <div class="form-group">
          <label>{{localize "PF2E_ITEM_FORGE.Fields.Craftsmanship"}}</label>
          <select name="treasure.craftsmanship">
            {{#each treasureCraftsmanship}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        {{/if}}
        <div class="form-group">
          <label>{{localize "PF2E_ITEM_FORGE.Fields.Condition"}}</label>
          <select name="treasure.condition">
            {{#each treasureConditions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        {{#if treasureSupportsMotif}}
        <div class="form-group">
          <label>{{localize "PF2E_ITEM_FORGE.Fields.Motif"}}</label>
          <select name="treasure.motif">
            {{#each treasureMotifs}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        {{/if}}
        <div class="form-group">
          <label>{{localize "PF2E_ITEM_FORGE.Fields.Style"}}</label>
          <select name="treasure.style">
            {{#each treasureStyles}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
      </fieldset>
    {{else}}
      <div class="form-group">
        <label>{{localize "PF2E_ITEM_FORGE.Fields.LevelMode"}}</label>
        <select name="levelMode">
          <option value="single" {{#unless isRange}}selected{{/unless}}>{{localize "PF2E_ITEM_FORGE.LevelMode.Single"}}</option>
          <option value="range" {{#if isRange}}selected{{/if}}>{{localize "PF2E_ITEM_FORGE.LevelMode.Range"}}</option>
        </select>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>{{#if isRange}}{{localize "PF2E_ITEM_FORGE.Fields.LevelMin"}}{{else}}{{localize "PF2E_ITEM_FORGE.Fields.Level"}}{{/if}}</label>
          <input type="number" name="level.min" min="0" max="30" value="{{request.level.min}}">
        </div>
        {{#if isRange}}
        <div class="form-group">
          <label>{{localize "PF2E_ITEM_FORGE.Fields.LevelMax"}}</label>
          <input type="number" name="level.max" min="0" max="30" value="{{request.level.max}}">
        </div>
        {{/if}}
      </div>

      <div class="form-group">
        <label>{{localize "PF2E_ITEM_FORGE.Fields.LevelPolicy"}}</label>
        <select name="levelPolicy">
          {{#each levelPolicies}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>

      <fieldset>
        <legend>{{localize "PF2E_ITEM_FORGE.Fields.Rarity"}}</legend>
        <label class="checkbox"><input type="checkbox" name="rarity" value="common" {{#if rarity.common}}checked{{/if}}> {{localize "PF2E_ITEM_FORGE.Rarity.Common"}}</label>
        <label class="checkbox"><input type="checkbox" name="rarity" value="uncommon" {{#if rarity.uncommon}}checked{{/if}}> {{localize "PF2E_ITEM_FORGE.Rarity.Uncommon"}}</label>
        <label class="checkbox"><input type="checkbox" name="rarity" value="rare" {{#if rarity.rare}}checked{{/if}}> {{localize "PF2E_ITEM_FORGE.Rarity.Rare"}}</label>
        <label class="checkbox"><input type="checkbox" name="rarity" value="unique" {{#if rarity.unique}}checked{{/if}}> {{localize "PF2E_ITEM_FORGE.Rarity.Unique"}}</label>
        <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.EmptyRarityMeansAll"}}</p>
      </fieldset>

      <fieldset>
        <legend>{{localize "PF2E_ITEM_FORGE.Fields.Sources"}}</legend>
        {{#if isScrollCategory}}<p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.ScrollSources"}}</p>{{/if}}
        {{#if isMagicMode}}<p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.MagicSources"}}</p>{{/if}}
        <div class="form-group">
          <select name="source.mode">
            {{#each sourceModes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        {{#if selectedSources}}
        <div class="pack-list">
          {{#each packs}}
            <label class="checkbox pack-list__entry">
              <input type="checkbox" name="sourcePack" value="{{id}}" {{#if checked}}checked{{/if}}>
              <span>{{label}}</span>
              <small>{{id}}{{#if contentSummary}} · {{contentSummary}}{{/if}}</small>
            </label>
          {{else}}
            <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.NoItemPacks"}}</p>
          {{/each}}
        </div>
        {{/if}}
      </fieldset>
    {{/if}}

    <details>
      <summary>{{localize "PF2E_ITEM_FORGE.Editor.Advanced"}}</summary>
      <div class="form-group">
        <label>{{localize "PF2E_ITEM_FORGE.Fields.SolverAttempts"}}</label>
        <input type="number" name="solver.maxAttempts" min="1" max="1000" value="{{request.solver.maxAttempts}}">
        <p class="hint">{{localize "PF2E_ITEM_FORGE.Hints.SolverAttempts"}}</p>
      </div>
      <div class="seed-line">
        <span>{{localize "PF2E_ITEM_FORGE.Fields.Seed"}}</span>
        <code>{{request.seed}}</code>
      </div>
    </details>
  </section>

  <section class="item-forge-panel item-forge-preview">
    <h3>{{localize "PF2E_ITEM_FORGE.Editor.Preview"}}</h3>
    {{#if busy}}
      <div class="empty-state"><i class="fa-solid fa-hammer fa-bounce"></i><p>{{localize "PF2E_ITEM_FORGE.Preview.Generating"}}</p></div>
    {{else if error}}
      <div class="error-state">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <strong>{{error.code}}</strong>
        <p>{{error.message}}</p>
      </div>
    {{else if preview}}
      <article class="preview-card">
        <img src="{{preview.img}}" alt="">
        <div class="preview-card__body">
          <h2>{{preview.name}}</h2>
          <div class="chips">
            <span>{{preview.type}}</span>
            {{#if preview.price}}<span>{{localize "PF2E_ITEM_FORGE.Preview.Price"}} {{preview.price}}</span>{{/if}}
            {{#unless preview.treasure}}
              <span>{{localize "PF2E_ITEM_FORGE.Preview.Level"}} {{preview.level}}</span>
              <span>{{preview.rarity}}</span>
            {{/unless}}
          </div>
          <dl>
            <dt>{{localize "PF2E_ITEM_FORGE.Preview.Source"}}</dt><dd>{{preview.sourcePack}}</dd>
            <dt>{{localize "PF2E_ITEM_FORGE.Preview.Candidates"}}</dt><dd>{{preview.candidateCount}}</dd>
            {{#if preview.spell}}
              <dt>{{localize "PF2E_ITEM_FORGE.Preview.Spell"}}</dt><dd>{{preview.spell.name}}</dd>
              <dt>{{localize "PF2E_ITEM_FORGE.Preview.SpellRank"}}</dt>
              <dd>{{preview.spell.rank}}{{#if preview.spell.heightened}} ({{localize "PF2E_ITEM_FORGE.Preview.HeightenedFrom"}} {{preview.spell.baseRank}}){{/if}}</dd>
            {{/if}}
            {{#if preview.magic}}
              <dt>{{localize "PF2E_ITEM_FORGE.Preview.MagicKind"}}</dt><dd>{{preview.magic.kindLabel}}</dd>
              {{#if preview.magic.staffModeLabel}}<dt>{{localize "PF2E_ITEM_FORGE.Preview.StaffMode"}}</dt><dd>{{preview.magic.staffModeLabel}}</dd>{{/if}}
              {{#if preview.magic.themeLabel}}<dt>{{localize "PF2E_ITEM_FORGE.Preview.MagicTheme"}}</dt><dd>{{preview.magic.themeLabel}}</dd>{{/if}}
              {{#if preview.magic.profileLabel}}<dt>{{localize "PF2E_ITEM_FORGE.Preview.StaffProfile"}}</dt><dd>{{preview.magic.profileLabel}}</dd>{{/if}}
              {{#if preview.magic.variantLabelLocalized}}<dt>{{localize "PF2E_ITEM_FORGE.Preview.StaffVariant"}}</dt><dd>{{preview.magic.variantLabelLocalized}}</dd>{{/if}}
              {{#if preview.magic.maxRank}}<dt>{{localize "PF2E_ITEM_FORGE.Preview.HighestSpellRank"}}</dt><dd>{{preview.magic.maxRank}}</dd>{{/if}}
            {{/if}}
            {{#if preview.spells.length}}
              <dt>{{localize "PF2E_ITEM_FORGE.Preview.SpellList"}}</dt>
              <dd class="staff-spell-list">
                {{#each preview.spells}}
                  <span class="property-rune-chip">
                    {{#if cantrip}}{{localize "PF2E_ITEM_FORGE.Magic.Cantrip"}}{{else}}{{localize "PF2E_ITEM_FORGE.Preview.SpellRank"}} {{rank}}{{/if}} · {{name}}{{#if heightened}} ({{localize "PF2E_ITEM_FORGE.Preview.HeightenedFrom"}} {{baseRank}}){{/if}}
                  </span>
                {{/each}}
              </dd>
            {{/if}}
            {{#if preview.runeProfile}}
              <dt>{{localize "PF2E_ITEM_FORGE.Preview.BaseItem"}}</dt><dd>{{preview.baseItem.name}} ({{localize "PF2E_ITEM_FORGE.Preview.Level"}} {{preview.baseItem.level}})</dd>
              <dt>{{localize "PF2E_ITEM_FORGE.Preview.RuneProfile"}}</dt><dd>{{preview.runeSummary}}</dd>
              <dt>{{localize "PF2E_ITEM_FORGE.Preview.PropertySlots"}}</dt><dd>{{preview.propertyRuneCapacity}}</dd>
              <dt>{{localize "PF2E_ITEM_FORGE.Preview.PropertyRunes"}}</dt>
              <dd>
                {{#each preview.propertyRunes}}
                  <span class="property-rune-chip">{{displayLabel}} ({{localize "PF2E_ITEM_FORGE.Preview.Level"}} {{level}})</span>
                {{else}}
                  {{localize "PF2E_ITEM_FORGE.PropertyRuneMode.None"}}
                {{/each}}
              </dd>
              <dt>{{localize "PF2E_ITEM_FORGE.Preview.EffectiveLevel"}}</dt><dd>{{preview.level}}</dd>
            {{/if}}
            {{#if preview.treasure}}
              <dt>{{localize "PF2E_ITEM_FORGE.Preview.TreasureType"}}</dt><dd>{{preview.treasure.type.label}}</dd>
              {{#if preview.treasure.material}}<dt>{{localize "PF2E_ITEM_FORGE.Fields.Material"}}</dt><dd>{{preview.treasure.material.label}}</dd>{{/if}}
              {{#if preview.treasure.craftsmanship}}<dt>{{localize "PF2E_ITEM_FORGE.Fields.Craftsmanship"}}</dt><dd>{{preview.treasure.craftsmanship.label}}</dd>{{/if}}
              <dt>{{localize "PF2E_ITEM_FORGE.Fields.Condition"}}</dt><dd>{{preview.treasure.condition.label}}</dd>
              <dt>{{localize "PF2E_ITEM_FORGE.Fields.Style"}}</dt><dd>{{preview.treasure.style.label}}</dd>
              {{#if preview.treasure.motif}}<dt>{{localize "PF2E_ITEM_FORGE.Fields.Motif"}}</dt><dd>{{preview.treasure.motif.label}}</dd>{{/if}}
              {{#if preview.treasure.attributeEntries.length}}
                <dt>{{localize "PF2E_ITEM_FORGE.Preview.Details"}}</dt>
                <dd>
                  {{#each preview.treasure.attributeEntries}}<span class="property-rune-chip">{{label}}</span>{{/each}}
                </dd>
              {{/if}}
              <dt>{{localize "PF2E_ITEM_FORGE.Preview.Value"}}</dt><dd>{{preview.value}} GM</dd>
              <dt>{{localize "PF2E_ITEM_FORGE.Preview.SolverAttempts"}}</dt><dd>{{preview.solverAttempts}}</dd>
              {{#if preview.treasure.components.length}}
                <dt>{{localize "PF2E_ITEM_FORGE.Preview.Components"}}</dt>
                <dd>
                  {{#each preview.treasure.components}}
                    <span class="property-rune-chip">{{label}}{{#if material}} · {{material}}{{/if}}{{#if quantity}} ×{{quantity}}{{/if}}</span>
                  {{/each}}
                </dd>
              {{/if}}
            {{/if}}
          </dl>
          {{#if preview.description}}
            <section class="preview-description">
              <h4>{{localize "PF2E_ITEM_FORGE.Preview.Description"}}</h4>
              <div class="preview-description__content">{{{preview.description}}}</div>
            </section>
          {{/if}}
          {{#if preview.warnings.length}}
            <div class="warning-box">
              {{#each preview.warnings}}<div><i class="fa-solid fa-triangle-exclamation"></i> {{code}}</div>{{/each}}
            </div>
          {{/if}}
        </div>
      </article>
    {{else}}
      <div class="empty-state"><i class="fa-regular fa-gem"></i><p>{{localize "PF2E_ITEM_FORGE.Preview.Empty"}}</p></div>
    {{/if}}
  </section>
</div>
